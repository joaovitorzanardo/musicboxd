{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SendAsNoReplyOnly",
      "Effect": "Allow",
      "Action": "ses:SendEmail",
      "Resource": "arn:aws:ses:us-east-1:<ACCOUNT_ID>:identity/*",
      "Condition": {
        "StringEquals": { "ses:FromAddress": "no-reply@musicboxd.com.br" }
      }
    }
  ]
}
