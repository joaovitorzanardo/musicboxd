# deploy/systemd/musicboxd-db-backup.service
[Unit]
Description=Back up the musicboxd Postgres database to S3
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/musicboxd
ExecStart=/opt/musicboxd/backup/backup-db.sh
# oneshot units have no start timeout by default: a hung dump or upload would sit in "activating" forever,
# skipping every later run without ever showing as failed.
TimeoutStartSec=1h
